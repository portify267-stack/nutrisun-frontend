# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build
/dist

# Environment variables & secrets (never commit actual credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Temporary audit files, scratch data, and test scripts
scratch/
scripts/
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Root audit screenshots (keep public assets under public/ intact)
/*.png
/*.jpg
/*.jpeg
!public/**

# Database dumps, backups, and audit json (whitelist configuration)
backups/
*.json
!package.json
!package-lock.json
!tsconfig.json
!vercel.json

# Typescript build cache
*.tsbuildinfo

# OS and editor metadata
.DS_Store
*.pem
.vscode/
.idea/
Thumbs.db
