# NutriSun Frontend Environment Configuration Template

# Client-side API URL (Used by the browser to reach the Go backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Internal Backend URL (Used for Server-Side Rendering / API proxy if applicable)
INTERNAL_BACKEND_URL=http://localhost:8080

# Business Payment UPI & QR Configuration
NEXT_PUBLIC_PAYEE_NAME="NutriSun Payments"
NEXT_PUBLIC_UPI_ID="nutrisun@upi"
NEXT_PUBLIC_QR_ASSET_PATH="/ICICIBank_QR.jpg"
NEXT_PUBLIC_PAYMENT_INSTRUCTION="Scan the QR code to complete your payment and upload your receipt screenshot."
